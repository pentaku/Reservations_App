<div class="container mt-4">

  <!-- 検索フォーム -->
  <%= form_with url: rooms_path, method: :get, local: true, class: "row g-3 mb-4 top-margin" do |f| %>
    <div class="col-md-3">
      <%= f.label :area, "エリア検索", class: "form-label" %>
      <%= f.select :area, ["東京", "大阪", "京都", "札幌"], { include_blank: "選択してください" }, class: "form-select" %>
    </div>

    <div class="col-md-5">
      <%= f.label :keyword, "フリーワード検索", class: "form-label" %>
      <%= f.text_field :keyword, value: params[:keyword], class: "form-control", placeholder: "施設名・詳細を検索" %>
    </div>

    <div class="col-md-2 d-flex align-items-end">
      <%= f.submit "検索", class: "btn btn-primary w-100" %>
    </div>
  <% end %>

  <h2 class= "top-margin">施設一覧</h2>


  <!-- 件数表示 -->
  <p class="mb-3">検索結果: <%= @total_count %> 件</p>

  <div class="row">
    <% @rooms.each do |room| %>
      <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100">

          <% if room.image.attached? %>
            <%= image_tag room.image.variant(resize_to_fill: [400, 250]).processed,
                          class: "card-img-top", alt: room.name %>
          <% else %>
            <%= image_tag "room/default.png",
                          class: "card-img-top", alt: "No image" %>
          <% end %>




          <div class="card-body">
            <h5 class="card-title"><%= room.name %></h5>
            <p class="text-warning mb-2">★★★★★</p>
            <p class="card-text text-muted"><%= truncate(room.description, length: 60) %></p>

            <div class="d-flex justify-content-between align-items-center mb-1">
              <p class="mb-0"><strong>料金:</strong> ¥<%= number_with_delimiter(room.price, delimiter: ",") %></p>
              <%= link_to "詳細を見る", room_path(room), class: "btn btn-sm btn-outline-primary" %>
            </div>

            <p class="mb-0"><strong>住所:</strong> <%= room.address %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
