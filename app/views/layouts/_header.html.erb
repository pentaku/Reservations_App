<header class="navbar navbar-expand-lg navbar-dark navbar-custom fixed-top">
  <div class="container">
    <%= link_to  "Potepan share", root_path, id: "logo" %>

    <nav>
      <ul class="nav navbar-nav navbar-right">
        <% if logged_in? %>
          <li class="dropdown">
            <%= link_to "#", class: "dropdown-toggle", data: { toggle: "dropdown" } do %>
              <% if current_user.image.attached? %>
              <%= image_tag current_user.image.variant(resize_to_fill: [30, 30]).processed,
                    class: "rounded-circle me-2", alt: current_user.name %>
              <% else %>
                <%= image_tag "user/default-avatar.png",
                      class: "rounded-circle me-2", size: "40x40", alt: "default icon" %>
              <% end %>

              <%= current_user.name %> <b class="caret"></b>
            <% end %>

            <ul class="dropdown-menu">
              <li><%= link_to "施設の新規登録", new_room_path %></li>
              <li class="divider"></li>
              <li><%= link_to "予約一覧", reservations_path%></li>
              <li><%= link_to "登録済み一覧", own_room_path %></li>
              <li><%= link_to "アカウント設定", users_account_path %></li>
              <li class="divider"></li>
              <li>
                <%= link_to "ログアウト", logout_path, method: :delete %>
              </li>
            </ul>
          </li>
        <% else %>
          <li class = "headerList_login"><%= link_to "ログイン", login_path %></li>
          <li><%= link_to "新規登録", signup_path %></li>
        <% end %>
      </ul>
    </nav>
  </div>
</header>
