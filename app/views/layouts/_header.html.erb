<header class="navbar navbar-expand-lg navbar-dark navbar-custom fixed-top">
  <div class="container">
    <%= link_to "Potepan share", root_path, id: "logo" %>
    <nav>
      <ul class="nav navbar-nav navbar-right">
        <% if logged_in? %>
          <li class="dropdown">
            <a href="#" class="dropdown-toggle" data-toggle="dropdown">
              Account <b class="caret"></b>
            </a>
            <ul class="dropdown-menu">
              <li><%= link_to "施設の新規登録", new_room_path %></li>
              <li><%= link_to "予約一覧", '#' %></li>
              <li><%= link_to "登録済み一覧", '#' %></li>
              <li><%= link_to "アカウント設定", '#' %></li>
              <li class="divider"></li>
              <li>
                <%= link_to "ログアウト", logout_path, method: :delete %>
              </li>
            </ul>
          </li>
        <% else %>
          <li><%= link_to "ログイン", login_path %></li>
          <li><%= link_to "新規登録", signup_path %></li>
        <% end %>
      </ul>
    </nav>
  </div>
</header>
