<% provide(:title, "Edit user") %>
<h1>Update your profile</h1>

<div class="row">
  <div class="col-md-6 mx-auto">
    <%= form_with(model: @user, local: true) do |f| %>
      <%= render 'shared/error_messages', object: f.object %>

      <%= f.label :name, "名前" %>
      <%= f.text_field :name, class: 'form-control' %>

      <%= f.label :email, "メール" %>
      <%= f.email_field :email, class: 'form-control' %>

      <%= f.label :current_password, "現在のパスワード" %>
      <%= f.password_field :current_password, class: 'form-control', placeholder: "" %>

      <%= f.label :password, "新しいパスワード" %>
      <%= f.password_field :password, class: 'form-control' %>

      <%= f.label :password_confirmation, "確認用パスワード" %>
      <%= f.password_field :password_confirmation, class: 'form-control' %>

      <%= f.submit "Save changes", class: "btn btn-primary" %>
      <!-- キャンセルボタンの追加 -->
      <%= link_to 'キャンセル', users_account_path, class: 'btn btn-outline-secondary ml-2' %>
    <% end %>
  </div>
</div>

